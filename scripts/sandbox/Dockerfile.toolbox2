# Imagen «caja de herramientas v2» del sandbox (perfil gvisor-python-toolbox-v2, fase 4).
# Mismo Python base fijado por digest que v1, mismas librerías de v1 y además: pandas, numpy,
# matplotlib, rembg (quitar fondo, modelo u2netp incluido) y Tesseract (OCR español/inglés).
# Se construye una vez CON red; los candidatos corren después SIN red, en solo lectura.
# Las versiones habilitadas con v1 siguen usando la imagen v1: esta no la reemplaza.
FROM python@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b

# Un solo hilo por librería (el sandbox limita procesos/hilos) y cachés en rutas de solo lectura.
ENV OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMBA_NUM_THREADS=1 \
    NUMBA_CACHE_DIR=/tmp/numba MPLBACKEND=Agg MPLCONFIGDIR=/opt/mpl U2NET_HOME=/opt/u2net \
    TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata

RUN apt-get update \
    && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-spa tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --disable-pip-version-check \
        pypdf==5.1.0 python-docx==1.1.2 openpyxl==3.1.5 reportlab==4.2.5 pillow==11.0.0 \
        lxml==6.1.3 chardet==7.7.0 et-xmlfile==2.0.0 typing-extensions==4.16.0 \
        numpy==2.1.3 pandas==2.2.3 matplotlib==3.9.2 pytesseract==0.3.13 \
        onnxruntime==1.20.1 opencv-python-headless==4.10.0.84 rembg==2.0.59

# Modelo de quitar fondo descargado ahora (sin red al ejecutar) y caché de fuentes de matplotlib.
RUN mkdir -p /opt/u2net /opt/mpl \
    && python -c "from rembg import new_session; new_session('u2netp')" \
    && python -c "import matplotlib.pyplot as plt; plt.figure(); plt.close('all')" \
    && chmod -R a+rX /opt/u2net /opt/mpl \
    && python -m compileall -q /usr/local/lib/python3.12 \
    && python -I -B -c "import pypdf, docx, openpyxl, reportlab, PIL, pandas, numpy, matplotlib, pytesseract, rembg; print('toolbox v2 ok')" \
    && tesseract --list-langs \
    && pip freeze > /opt/toolbox-v2-freeze.txt

# Al final para reutilizar las capas anteriores. Probado en gVisor: importar rembg pasa de 60 s
# (numba/scipy), así que quitar el fondo usa capacita_fondo (onnxruntime + u2netp, ~6 s).
# matplotlib necesita una carpeta escribible o escribe avisos que se mezclan con la salida.
ENV MPLCONFIGDIR=/tmp/mpl
COPY capacita_fondo.py /usr/local/lib/python3.12/site-packages/capacita_fondo.py
RUN python -m compileall -q /usr/local/lib/python3.12/site-packages/capacita_fondo.py \
    && python -I -B -c "import capacita_fondo; print('capacita_fondo ok')"
