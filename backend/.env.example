# Configuración general de la API
PROJECT_NAME="CAPACITA API"
VERSION="0.1.0"
DESCRIPTION="API Backend para CAPACITA - Plataforma de Intercambio de Capacidades"
ENVIRONMENT="development"
DEBUG=True

# Configuración del servidor
HOST="127.0.0.1"
PORT=8000
API_PREFIX="/api"

# CORS (Orígenes permitidos, separados por comas o lista JSON)
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Mismo proyecto que el frontend. Clave publishable/anon, nunca service_role.
# Las consultas usan el token de cada usuario para mantener RLS.
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_ANON_KEY="tu-clave-publica-publishable-o-anon"

# Gemini: solo backend. Confirmar nivel gratuito/cuota de la cuenta; no activar cobro.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-4-hydrogen"
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_OUTPUT_TOKENS=8192
# Investigación web antes de empezar (Grounding with Google Search). Gratis en
# gemini-2.5-flash hasta el 01/12/2026; si falla, el chat sigue sin fuentes.
RESEARCH_ENABLED=true
RESEARCH_MODEL="gemini-2.5-flash"
RESEARCH_TIMEOUT_SECONDS=30
# Reparaciones por usuario/hora/proceso; 0 las desactiva. También consumen cuota general.
CANDIDATE_REPAIR_LIMIT=4
# Telegram (fase 3): token de @BotFather (secreto) y usuario del bot sin @
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
