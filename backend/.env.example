# Configuración general de la API
PROJECT_NAME="CAPACITA API"
VERSION="0.1.0"
DESCRIPTION="API Backend para CAPACITA - Plataforma de Intercambio de Capacidades"
ENVIRONMENT="development"
DEBUG=True

# Configuración del servidor
HOST="127.0.0.1"
PORT=8000
API_PREFIX="/api"

# CORS (Orígenes permitidos, separados por comas o lista JSON)
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
